---
/**
 * Header product switcher.
 *
 * With more than a couple of products, the landing page stops being a good enough
 * switcher: getting from one product to another means going back to the root first.
 * This puts every product one click away from any page.
 *
 * Options come from src/data/products.mjs, the same list that builds the sidebar and
 * the landing page index, so a new product appears here without anyone remembering to
 * add it. Built on Starlight's own Select so it matches the theme picker exactly.
 *
 * Registered as Starlight's `LanguageSelect` component. That slot sits next to the
 * theme picker in the desktop header and again in the mobile menu, which is where a
 * picker belongs and keeps it away from the logo. This site is not multilingual, so
 * the slot is otherwise empty.
 */
import Select from '@astrojs/starlight/components/Select.astro';
import { products } from '../data/products.mjs';

const { id } = Astro.locals.starlightRoute;

// The docs loader gives the root index page an empty id; everything else is prefixed
// with its product folder.
const currentDirectory = id.split('/')[0];
const onAProduct = products.some((product) => product.directory === currentDirectory);

// Internal products are suffixed here rather than only grouped by the script below, so
// the distinction survives with JavaScript off. The script strips the suffix once it has
// moved the option under an "Internal" optgroup, which says the same thing once instead
// of twice.
const options = [
	{
		label: 'All products',
		value: '/',
		selected: !onAProduct,
	},
	...products.map((product) => ({
		label: product.internal ? `${product.name} (Internal)` : product.name,
		value: product.href,
		selected: product.directory === currentDirectory,
	})),
];

const internalHrefs = products.filter((product) => product.internal).map((product) => product.href);
---

<tc-product-switch class="tc-product-switch" data-internal={JSON.stringify(internalHrefs)}>
	<Select icon="bars" label="Select a product" options={options} width="11.5em" />
</tc-product-switch>

<script>
	class TophhieProductSwitch extends HTMLElement {
		constructor() {
			super();
			const select = this.querySelector('select');
			if (select) this.groupOptions(select);
			select?.addEventListener('change', (event) => {
				if (event.currentTarget instanceof HTMLSelectElement) {
					// Values are either a root-relative path or an absolute URL for a
					// product documented on its own site, so assign the whole href.
					window.location.href = event.currentTarget.value;
				}
			});
		}

		/**
		 * Split the flat option list into "Public" and "Internal" groups.
		 *
		 * Starlight's Select renders plain options and has no way to express groups, so
		 * they are built here instead of forking the component. "All products" stays
		 * ungrouped at the top, because it is a reset rather than a product.
		 */
		groupOptions(select: HTMLSelectElement) {
			let internal: string[] = [];
			try {
				internal = JSON.parse(this.dataset.internal || '[]');
			} catch {
				return; // Malformed data: leave the flat list, which still reads correctly.
			}
			if (internal.length === 0) return;

			const options = [...select.querySelectorAll('option')];
			const products = options.filter((option) => option.value !== '/');
			if (products.length === 0) return;

			const groupFor = (label: string) => {
				const group = document.createElement('optgroup');
				group.label = label;
				return group;
			};
			const publicGroup = groupFor('Public');
			const internalGroup = groupFor('Internal');

			for (const option of products) {
				if (internal.includes(option.value)) {
					// The group label now carries the distinction, so drop the suffix that
					// exists for the no-JavaScript case.
					option.textContent = option.textContent?.replace(/\s*\(Internal\)$/, '') ?? '';
					internalGroup.append(option);
				} else {
					publicGroup.append(option);
				}
			}

			if (publicGroup.children.length > 0) select.append(publicGroup);
			if (internalGroup.children.length > 0) select.append(internalGroup);
		}
	}

	customElements.define('tc-product-switch', TophhieProductSwitch);
</script>
